@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam componentStyle uml2
skinparam linetype ortho
skinparam shadowing false
skinparam ArrowColor #606060
skinparam FontColor #404040
skinparam nodesep 80
skinparam ranksep 100
skinparam defaultFontName Arial
left to right direction

title "MGL870 — Organisation des packages Rust"

package "mgl870-benchmark-ipc" {
  [main.rs] as Main
  [models.rs\nTick] as Models

  package "rest" #E6F7FF {
    [Router REST\nAxum] as Rest
  }
  package "graphql" #E6F7FF {
    [Schema et mutations\nasync-graphql] as Graphql
    [TickInput\ntype GraphQL] as GraphqlInput
  }
  package "jsonrpc" #E6F7FF {
    [Handler RPC\njsonrpsee + serde_json] as JsonRpc
  }
  package "grpc" #E6F7FF {
    [Service RPC\ntonic + prost] as Grpc
    [TickMessage / TickList\ntypes générés] as GrpcTypes
    artifact "proto/tick.proto" as Proto
  }
}

Main --> Rest
Main --> Graphql
Main --> JsonRpc
Main --> Grpc
Rest --> Models : désérialise Tick
JsonRpc --> Models : désérialise JSON
Graphql --> GraphqlInput : utilise
Proto --> GrpcTypes : tonic-build / prost
Grpc --> GrpcTypes : utilise

note bottom of Main
HTTP/1.1 : port 8080
HTTP/2 : port 50051
end note

legend right
Le même binaire Rust expose les trois routeurs HTTP
et démarre le service gRPC. REST et JSON-RPC partagent
le type Tick; GraphQL et gRPC utilisent des types équivalents
définis par leur schéma ou générés depuis tick.proto.
end legend
@enduml
