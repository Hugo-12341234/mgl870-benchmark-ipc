@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam ArrowColor #606060
skinparam FontColor #404040
skinparam nodesep 70
skinparam ranksep 90
skinparam defaultFontName Arial

title "MGL870 — Workflow expérimental reproductible"

start
:Exécuter cargo test
et valider les contrats;
:Construire l’image Rust;
:Créer le réseau Docker
et les quatre serveurs;
:Appliquer 0,25 vCPU
et 512 MiB par serveur;
:Attribuer un testid unique;
:Redémarrer les quatre serveurs
et vérifier leur disponibilité;

if (Scénario ?) then (Unitaire)
  :Charger load_test.js;
  :2 000 -> 4 000 -> 6 000 req/s;
  :10 minutes;
else (Batch)
  :Charger load_test_batch.js;
  :100 -> 500 -> 500 req/s;
  :7 minutes;
endif

:Exécuter REST, GraphQL,
JSON-RPC et gRPC en parallèle;
:Collecter latence, débit,
erreurs et itérations;
:Collecter CPU, mémoire
et réseau des serveurs et de k6;
:Exporter résumé k6,
séries Prometheus et manifeste;
:Valider checks, erreurs
et couverture télémétrique;

if (5 répétitions par scénario ?) then (Non)
  :Alterner le scénario
et rejouer le run suivant;
else (Oui)
  :Consolider moyenne, min, max,
coefficient de variation et pics;
  :Choisir les runs représentatifs
par règle médiane;
  :Capturer Grafana pour
les deux runs représentatifs;
  :Comparer les protocoles;
  :Analyser les compromis;
endif
stop
@enduml
