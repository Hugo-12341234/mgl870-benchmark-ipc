        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": {
          "query": "label_values(k6_protocol_requests_total, testid)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(k6_protocol_requests_total, testid)",
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
